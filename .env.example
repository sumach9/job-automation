# ── Server ────────────────────────────────────────────────────────────────────
PORT=3004

# ── Admin Login (dashboard access) ───────────────────────────────────────────
ADMIN_USERNAME=admin
ADMIN_PASSWORD=applyai2024
# Generate a strong secret: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-this-before-deploying

# ── Job Search ────────────────────────────────────────────────────────────────
# Apify token for scraping LinkedIn, Indeed, Glassdoor, ZipRecruiter
# Get free token: https://console.apify.com/account/integrations
APIFY_TOKEN=

# SerpAPI for Google Jobs scraping (5000 free searches/month)
# Get key: https://serpapi.com/dashboard
SERPAPI_KEY=

# ── Job Search Config ─────────────────────────────────────────────────────────
JOB_TITLES=Data Scientist,Data Engineer,ML Engineer
JOB_LOCATIONS=Remote,United States
INTERVAL_MINUTES=5
MAX_APPS_PER_RUN=10
MAX_BROWSER_OPENS=5

# ── LinkedIn Auto-Apply ───────────────────────────────────────────────────────
LINKEDIN_EMAIL=
LINKEDIN_PASSWORD=
AUTO_APPLY_ENABLED=false

# ── Email Notifications ───────────────────────────────────────────────────────
# Use a Gmail App Password (not your main password)
# Enable at: https://myaccount.google.com/apppasswords
EMAIL_USER=
EMAIL_PASS=
NOTIFY_EMAIL=
EMAIL_NOTIFICATIONS=false

# ── Applicant Profile ─────────────────────────────────────────────────────────
APPLICANT_NAME=
APPLICANT_EMAIL=
APPLICANT_PHONE=
APPLICANT_LOCATION=
APPLICANT_YEARS_EXPERIENCE=
RESUME_PATH=

# ── Simplify Integration ──────────────────────────────────────────────────────
# "shell" = opens in your local Chrome | "playwright" = headless (server)
SIMPLIFY_MODE=shell
SIMPLIFY_AUTO_SUBMIT=false

# ── Stripe Payments ───────────────────────────────────────────────────────────
# 1. Create account at https://dashboard.stripe.com
# 2. Get secret key from Developers → API keys
# 3. Create two recurring prices (Pro $29/mo, Enterprise $99/mo)
#    Copy each price's ID (starts with price_...)
# 4. Set up webhook: Stripe Dashboard → Developers → Webhooks
#    Endpoint URL: https://YOUR_DOMAIN/api/billing/webhook
#    Events: checkout.session.completed, customer.subscription.deleted
STRIPE_SECRET_KEY=
STRIPE_PRICE_PRO=
STRIPE_PRICE_ENTERPRISE=
STRIPE_WEBHOOK_SECRET=
